# Copy to .env.local for local development, and add the same values in Vercel → Settings → Environment Variables.
# Never commit real values.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://pictopia-photobooth.vercel.app
NEXT_PUBLIC_AGENCY_NAME=CK David

# --- Supabase (Project Settings → API) ---------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=
# Secret key (sb_secret_...) or legacy service_role key. Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Gmail (sending account) -------------------------------------------------
# The Gmail address that sends notifications, e.g. pictopiamirrorphotobooth@gmail.com
GMAIL_USER=
# 16-character Google App Password (Google Account → Security → 2-Step Verification → App passwords)
GMAIL_APP_PASSWORD=
# Optional: where booking/enquiry notifications go. Defaults to GMAIL_USER.
NOTIFY_EMAIL=
